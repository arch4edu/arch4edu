# NOTICE
# Community package, not affiliated with or endorsed by the pypdfium2 authors.
# Do not report issues upstream:
# https://github.com/pypdfium2-team/pypdfium2#unofficial-packages

pkgname=python-pypdfium2
_name=${pkgname#python-}
pkgver=5.14.0
pkgrel=2
pkgdesc='Python bindings to PDFium (community package)'
arch=(x86_64)
url='https://github.com/pypdfium2-team'
license=('Apache-2.0 OR BSD-3-Clause')
depends=(
  'python'
)
makedepends=(
  'git'
  'pkgconf'
  'python-build'
  'python-installer'
  'python-packaging'
  'python-setuptools>=70.1.0'
)
optdepends=(
  'python-numpy: NumPy views of rendered bitmaps'
  'python-opencv: saving renders with OpenCV in the CLI'
  'python-pillow: PIL image conversion and image saving in the CLI'
  'python-tabulate: nicer table output in the CLI'
)
checkdepends=(
  'python-pytest'
  'python-numpy'
  'python-opencv'
  'python-pillow'
  'python-tabulate'
)
source=("${_name}::git+${url}/${_name}.git#tag=${pkgver}"
        "${_name}-ctypesgen::git+${url}/ctypesgen.git"
        'sys-pdfium-ver-fix.patch')
sha256sums=('059f64b99c3c5fd75467ba089ba0abc69c55244e83f993bb6ebd1ed59a2818b6'
            'SKIP'
            '605bd13795cb2ca3bc112002983e7993c2add5dbf8ab6925b6e0b991f2dd91de')

prepare() {
  cd "${_name}"

  ln -s "${srcdir}/${_name}-ctypesgen" deps/ctypesgen

  patch -Np1 -i ../sys-pdfium-ver-fix.patch
}

build() {
  cd "${_name}"

  export CPP='gcc -E -std=gnu17'

  python -m build --wheel --no-isolation
}

check() {
  cd "${_name}"

  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  PATH="${PWD}/test-env/bin:${PATH}" \
    test-env/bin/python -P -m pytest tests
}

package() {
  cd "${_name}"

  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSES/BSD-3-Clause.txt -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
