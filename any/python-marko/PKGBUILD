# Contributor: Joao Freitas <joaj.freitas@gmail.com>

_pkgname='marko'
pkgname="python-${_pkgname}"
pkgver=2.2.4
pkgrel=1
pkgdesc='A markdown parser with high extensibility'
arch=('any')
url="https://github.com/frostming/${_pkgname}"
license=('MIT')
depends=('python>=3.9')
makedepends=(
	'python-build'
	'python-installer'
	'python-pdm-backend'
	'python-wheel'
)
checkdepends=(
	'python-pygments'
	'python-pytest'
	'python-slugify'
)
optdepends=(
	'python-objprint: enhanced AST representations'
	'python-pygments: syntax highlighting extension'
	'python-slugify: table-of-contents slug generation'
)
source=("${_pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
b2sums=('1ed0e525729cae387488355f8b2e03f9e9745441d65b9466a12a74b0ec99b922878f4c76089b4c1998946dcf7d7766a4908eb574eff14d50338659a3b8810a12')

build() {
	cd -- "${_pkgname}-${pkgver}" || return 1
	python -m build --wheel --no-isolation
}

check() {
	cd -- "${_pkgname}-${pkgver}" || return 1
	python -m pytest tests
}

package() {
	cd -- "${_pkgname}-${pkgver}" || return 1
	python -m installer --destdir="${pkgdir}" --compile-bytecode 0 --compile-bytecode 2 dist/*.whl
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
makedepends+=("python-installer")
