# Maintainer: Jingbei Li <i@jingbei.li>
_base=vcs_versioning
pkgname=pypy3-vcs-versioning
pkgdesc="The blessed package to manage your versions by vcs metadata"
pkgver=2.6.0
pkgrel=1
arch=(any)
url="https://github.com/pypa/setuptools-scm"
license=(MIT)
depends=(pypy3-packaging)
makedepends=(pypy3-build pypy3-installer pypy3-setuptools)
source=(${_base}-${pkgver}.tar.gz::https://files.pythonhosted.org/packages/ad/e7/2a691db7d076b75d099fdba1a14cd966931f2aeb591e77f6d22f15097326/vcs_versioning-2.6.0.tar.gz)
sha256sums=('22e9159288e2d8bca2fa6f6c31c34c9c66aec157f60e9e526f5d160d2516d60f')

build() {
  cd ${_base}-${pkgver}
  pypy3 -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd ${_base}-${pkgver}
  PYTHONPYCACHEPREFIX="${PWD}/.cache/cpython/" pypy3 -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm 644 LICENSE.txt -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
