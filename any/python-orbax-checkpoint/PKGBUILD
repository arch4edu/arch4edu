# Maintainer: Daniel Bershatsky <bepshatsky@yandex.ru>

pkgname=python-orbax-checkpoint
_pkgname=${pkgname#python-}
pkgver=0.12.9
pkgrel=1
pkgdesc='Common utility libraries for JAX users (checkpoint).'
arch=('any')
url='https://github.com/google/orbax'
license=('Apache-2.0')
depends=(
    'python-absl'
    'python-aiofiles'
    'python-etils'
    'python-humanize'
    'python-jax>=0.6.0'
    'python-msgpack'
    'python-nest-asyncio'
    'python-numpy'
    'python-protobuf'
    'python-psutil'
    'python-simplejson'
    'python-tensorstore'
    'python-typing_extensions'  # etils[epy]
    'python-uvloop'
    'python-yaml'
)
makedepends=('python-build' 'python-flit-core' 'python-installer')
optdepends=(
    'python-orbax-export: Serialization JAX to TensorFlow Saved Models'
    'python-prometheus-client: Expose telemetry to Prometheus'
)
conflicts=('python-orbax')
replaces=('python-orbax')
source=("$_pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
    'python-orbax-checkpoint.diff')
sha256sums=('f6fa81b7c8dbbad554cbb02d765660a2f0a9cd79306c240af5416e2205477455'
            'SKIP')

prepare() {
    cd orbax-$pkgver/checkpoint
    patch -p1 -i../../python-orbax-checkpoint.diff
}

build() {
    python -m build -nw orbax-$pkgver/checkpoint
}

check() {
    cd orbax-$pkgver/checkpoint
    PYTHONPATH="$PWD:$PYTHONPATH" python -c 'import orbax.checkpoint'
}

package() {
    cd orbax-$pkgver
    install -Dm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
    python -m installer --compile-bytecode=1 --destdir=$pkgdir \
        checkpoint/dist/orbax_checkpoint-$pkgver-*.whl
}
