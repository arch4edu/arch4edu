_pkgname='docling-parse'
_blend2d_commit='6dbc2cefbc996379e07104e34519a440b49b15d7'
_asmjit_commit='0bd5787b54b575ed94bf32ac452153b34385c514'
_loguru_commit='4adaa185883e3c04da25913579c451d3c32cfac1'
pkgname="python-${_pkgname}"
pkgver='7.17.0'
pkgrel=1
pkgdesc='Simple package to extract text with coordinates from programmatic PDFs'
arch=(
	'x86_64'
	'aarch64'
)
url="https://github.com/docling-project/${_pkgname}"
license=(
	'MIT'
	'Zlib'
	'Unlicense'
	'BSD-3-Clause'
	'BSL-1.0'
)
depends=(
	'python>=3.10'
	'python-docling-core>=2.85.0'
	'python-pillow>=10.0.0'
	'python-pydantic>=2.0.0'
	'qpdf'
	'libjpeg-turbo'
	'openjpeg2'
	'lcms2'
	'freetype2'
	'zlib'
)
makedepends=(
	'cmake'
	'pkgconf'
	'cxxopts'
	'nlohmann-json'
	'utf8cpp'
	'python-build'
	'python-installer'
	'pybind11'
	'python-setuptools'
	'python-wheel'
)
checkdepends=(
	'python-pytest'
	'python-huggingface-hub>=1.11.0'
)
optdepends=('noto-fonts-cjk: CJK fallback rendering for PDFs with non-embedded CJK fonts')
source=(
	"${_pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
