prepare() {
	cd -- "${_pkgname}-${pkgver}" || return 1
	patch -Np1 -i "${srcdir}/pyproject_toml_dep.patch"
	patch -Np1 -i "${srcdir}/system_deps.patch"
	patch -Np1 -i "${srcdir}/skip_uninstalled_apps.patch"
	patch -Np1 -i "${srcdir}/reproducible_paths.patch"
}

build() {
	local _python_version
	_python_version=$(python --version)
	_python_version=${_python_version#Python }
	_python_version=${_python_version%.*}
	if [[ ! ${_python_version} =~ ^[0-9]+\.[0-9]+$ ]]; then
		printf 'Unable to determine Python major.minor version: %s\n' "${_python_version}" >&2
		return 1
	fi

	cd -- "${_pkgname}-${pkgver}" || return 1
	CFLAGS="${CFLAGS} -ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname}" \
		CXXFLAGS="${CXXFLAGS} -ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname}" \
		USE_SYSTEM_DEPS='ON' \
		CMAKE_ARGS="-DDOCLING_PARSE_BLEND2D_SOURCE_DIR=${srcdir}/blend2d-${_blend2d_commit} -DDOCLING_PARSE_ASMJIT_SOURCE_DIR=${srcdir}/asmjit-${_asmjit_commit} -DDOCLING_PARSE_LOGURU_SOURCE_DIR=${srcdir}/loguru-${_loguru_commit} -DDOCLING_PARSE_ROOT_PATH=/usr/lib/python${_python_version}/site-packages" \
		python -m build --wheel --no-isolation
}

check() {
	local _python_version
	local _checkdir="${srcdir}/${pkgname}-check"
	local _source="${srcdir}/${_pkgname}-${pkgver}"

	_python_version=$(python --version)
	_python_version=${_python_version#Python }
	_python_version=${_python_version%.*}
	if [[ ! ${_python_version} =~ ^[0-9]+\.[0-9]+$ ]]; then
		printf 'Unable to determine Python major.minor version: %s\n' "${_python_version}" >&2
		return 1
	fi

	rm -rf -- "${_checkdir}"
	cd -- "${_source}" || return 1
	python -m installer --destdir="${_checkdir}" dist/*.whl

	cd -- "${srcdir}" || return 1
	HF_HUB_OFFLINE=1 \
		PYTHONPATH="${_checkdir}/usr/lib/python${_python_version}/site-packages:${_source}" \
		python -m pytest -q --import-mode=importlib --noconftest \
			"${_pkgname}-${pkgver}/tests/test_unit_load_failure.py" \
			"${_pkgname}-${pkgver}/tests/test_unit_actual_text.py" \
			"${_pkgname}-${pkgver}/tests/test_unit_cmap_encoding.py" \
			"${_pkgname}-${pkgver}/tests/test_unit_standard_font_widths.py" \
			"${_pkgname}-${pkgver}/tests/test_unit_indexed_images.py" \
			"${_pkgname}-${pkgver}/tests/test_unit_font_fallback.py" \
			"${_pkgname}-${pkgver}/tests/test_unit_unicode_paths.py"
}

package() {
	cd -- "${_pkgname}-${pkgver}" || return 1
	python -m installer --destdir="${pkgdir}" --compile-bytecode 2 dist/*.whl

	install -D -m644 -- LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 -- "${srcdir}/blend2d-${_blend2d_commit}/LICENSE.md" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.blend2d"
	install -D -m644 -- "${srcdir}/asmjit-${_asmjit_commit}/LICENSE.md" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.asmjit"
	install -D -m644 -- "${srcdir}/loguru-${_loguru_commit}/LICENSE" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.loguru"
	install -D -m644 -- "${srcdir}/PDFIUM-LICENSE" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.pdfium"
	install -D -m644 -- "${srcdir}/CHROMIUM-LICENSE" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.chromium"
	install -D -m644 -- docling_parse/pdf_resources/cmap-resources/LICENSE.md \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.adobe-cmap"
	install -D -m644 -- /usr/share/licenses/cxxopts/LICENSE \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.cxxopts"
	install -D -m644 -- /usr/share/licenses/nlohmann-json/LICENSE.MIT \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.nlohmann-json"
	install -D -m644 -- /usr/share/licenses/utf8cpp/LICENSE \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.utf8cpp"
	install -D -m644 -- /usr/share/licenses/pybind11/LICENSE \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.pybind11"
}
makedepends+=("python-setuptools" "pybind11" "cmake" "git")
