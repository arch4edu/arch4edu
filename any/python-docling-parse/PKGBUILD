	"loguru-${_loguru_commit}.tar.gz::https://github.com/emilk/loguru/archive/${_loguru_commit}.tar.gz"
	'PDFIUM-LICENSE'
	'CHROMIUM-LICENSE'
	'pyproject_toml_dep.patch'
	'system_deps.patch'
	'skip_uninstalled_apps.patch'
	'reproducible_paths.patch'
)
