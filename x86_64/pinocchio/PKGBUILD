package_pinocchio() {
    DESTDIR="$pkgdir/" cmake --build "build-$pkgver" -t install
    rm -rf $pkgdir/usr/share/doc
    install -Dm644 "$pkgbase-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_pinocchio-docs() {
    DESTDIR="$pkgdir/" cmake --build "build-$pkgver" -t install
    rm -rf $pkgdir/usr/{lib,include,bin,share/{"$_pkgname",ament,ament_index}}
    install -Dm644 "$pkgbase-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
makedepends+=("pybind11")

prepare() {
    sed -i '/^namespace pinocchio$/i\
namespace pinocchio::graph {\
  inline bool operator==(const Geometry & lhs, const Geometry & rhs) { return &lhs == &rhs; }\
}\
' "$srcdir/$pkgbase-$pkgver/bindings/python/parsers/graph/expose-geometries.cpp"
}
