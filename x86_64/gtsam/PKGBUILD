# Maintainer: envolution
# Contributor: Kartik Mohta <kartikmohta@gmail.com>
# shellcheck shell=bash disable=SC2034,SC2154
pkgname=gtsam
pkgver=4.3.0
pkgrel=1
epoch=1
pkgdesc="A library of C++ classes that implement smoothing and mapping (SAM) in\
  robotics and vision, using factor graphs and Bayes networks as the underlying\
  computing paradigm rather than sparse matrices."
url="https://gtsam.org/"
arch=('x86_64' 'i686')
provides=("gtsam=${pkgver}")
license=('BSD-3-Clause')
depends=('eigen')
makedepends=('cmake')
source=("https://github.com/borglab/${pkgname}/archive/${pkgver}.tar.gz")
sha256sums=('4539afcd47d336864deb8399e0a9a5c283a638f605892c942ec46f3541fd4fb0')
b2sums=('2ae96caa40c961f8785fdfb1f513a1d9f05d87c4e9c85060e2b3e9b50c92c0ec3c45edebc762557c34597755645b48937311a10507f1f4abbd020d2e04052fd8')

build() {
  sed -i 's/ system filesystem/ filesystem/;s/OR NOT Boost_SYSTEM_LIBRARY //;/Boost::system/d' "${pkgname}-${pkgver}/cmake/HandleBoost.cmake"
  cmake -B build -S "${pkgname}-${pkgver}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX='/usr' \
    -DGTSAM_BUILD_DOCS=OFF \
    -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF \
    -DGTSAM_BUILD_TESTS=ON \
    -DGTSAM_BUILD_WITH_CCACHE=OFF \
    -DGTSAM_BUILD_WITH_MARCH_NATIVE=OFF \
    -DGTSAM_INSTALL_CPPUNITLITE=OFF \
    -DGTSAM_INSTALL_GEOGRAPHICLIB=OFF \
    -DGTSAM_USE_BOOST_FEATURES=OFF \
    -DGTSAM_USE_SYSTEM_EIGEN=ON \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DGTSAM_BUILD_WITH_WERROR=OFF \
    -Wno-dev
  cmake --build build --target all all.tests
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

prepare() {
  sed -i 's/Eigen::MatrixBase<[^>]*>::ConstantReturnType/auto/g' "$srcdir/${pkgname}-${pkgver}/gtsam/base/Vector.h"
  sed -i 's/Eigen::MatrixBase<[^>]*>::ConstantReturnType/auto/g' "$srcdir/${pkgname}-${pkgver}/gtsam/base/Matrix.h"
}
makedepends+=("boost")
depends+=("boost-libs")
