# Maintainer: Carlos Aznarán <caznaranl@uni.pe>
_base=GKlib
pkgname=${_base,,}
pkgver=0.0.1
pkgrel=1
pkgdesc="A library of various helper routines and frameworks used by many of the lab's software"
arch=(x86_64)
url="https://github.com/KarypisLab/${_base}"
license=(Apache-2.0 LGPL-2.1-or-later BSD-3-Clause)
depends=(glibc) # openmp
makedepends=(cmake git)
source=(git+${url}.git#tag=v${pkgver})
sha512sums=('3dae5af7bc254086f31c3af43fa69748b7986e18a153e2e4388071c80dedcd4158ce122232778ec51200922105b96db0cb71af837e952cc5deca6b9b95310436')

build() {
  cd ${_base}
  make config cc=gcc prefix=/usr shared=1
}

package() {
  cd ${_base}
  make install DESTDIR="${pkgdir}"
  install -Dm 644 LICENSE.txt LICENSES.md -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
epoch=1
