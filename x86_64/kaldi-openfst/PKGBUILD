# Maintainer: Jingbei Li <i@jingbei.lli>
pkgname=kaldi-openfst
_pkgname=kaldi
pkgdesc='Speech recognition research toolkit'
pkgver=1.8.4
pkgrel=2
depends=(gcc-libs)
makedepends=(gcc-fortran git python sox subversion unzip wget)
arch=('x86_64')
url='https://github.com/kaldi-asr/kaldi'
license=('Apache-2.0')
options=(!lto)
_commit='e02e35f0254bb033fab73d1df99fc34123e31d56'
source=("${url}/archive/${_commit}.tar.gz"
        "https://www.openfst.org/twiki/pub/FST/FstDownload/openfst-${pkgver}.tar.gz")
sha256sums=('fd77fa31e8f21ccbc050bd0ee9ab80e3e0d83ad827b4e5a4d9a4cf7144ff62c1'
            'a8ebbb6f3d92d07e671500587472518cfc87cb79b9a654a5a8abb2d0eb298016')

build () {
	cd $srcdir/$_pkgname-$_commit/tools
	mkdir -p python
	touch python/.use_default_python
	make DOWNLOAD_DIR=$srcdir openfst
}

package () {
	mkdir -p $pkgdir/opt/$_pkgname/tools/openfst-$pkgver
	cd $pkgdir/opt/$_pkgname/tools
	ln -s openfst-$pkgver openfst
	cp -r $srcdir/$_pkgname-$_commit/tools/openfst-$pkgver/{bin,include,lib,Makefile} openfst-$pkgver
}
