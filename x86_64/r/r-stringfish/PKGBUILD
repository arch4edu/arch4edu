_pkgname=stringfish
_pkgver=0.19.2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Alt String Implementation"
arch=(x86_64)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-only')
depends=(
  onetbb
  pcre2
  r-rcpp
  r-rcppparallel
  xxhash
)
optdepends=(
  r-knitr
  r-rmarkdown
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz"
        "system-libs.patch")
md5sums=('57576d40c0bb72dcf673c5ecef2d49e8'
         '685b52efc1bfcd2574e559f9df64560e')
b2sums=('2797f6a352fddfabb268d0cbf21f94315519ae9be37d95dfdb4ff4eda7ed46e6301c8e49dd7c4edb1ced675a82896578b5eed96d9f8340bd0602279e9b79cdda'
        'a56459ada70af48192f87952f0bf3c7badf8f9f0159a9ef1cef6d0c9bb9d1faaaa61d82c4a91b4538cd37b3cbca657ddd744ce910379500a8ed8fca7f7a4fd35')

