pkgname=jags
pkgver=5.0.2
pkgrel=1
pkgdesc="Bayesian hierarchical models using Markov Chain Monte Carlo (MCMC) simulation"
arch=('any')
url="https://mcmc-jags.sourceforge.io/"
license=('GPL')
depends=('lapack' 'libtool')
options=('!libtool')
makedepends=('gcc-fortran' 'lapack')
source=(https://downloads.sourceforge.net/project/mcmc-jags/JAGS/5.x/Source/JAGS-$pkgver.tar.gz)
sha1sums=('9e74f583d67dfba737465ea0547270136799024a')

build () {
	cd "$srcdir/JAGS-$pkgver"
	./configure --prefix=/usr --libexecdir=/usr/lib/${pkgname}
	make
}

package() {
	cd "$srcdir/JAGS-$pkgver"
	make DESTDIR="$pkgdir/" install
}
