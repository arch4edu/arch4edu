prepare() {
    # Clone the repos
    printf "Cloning ros2 repositories\n"
    mkdir -p "$srcdir/ros2/src"
    vcs import --retry 10 "$srcdir/ros2/src" < $srcdir/ros2-release-${_rosdist_short}-${pkgver//.}/ros2.repos

    printf "Patching sources\n"
    # Fix the vendored zenoh-c build for this environment (cbindgen signatures + static_init).
    _zcv="$srcdir/ros2/src/ros2/rmw_zenoh/zenoh_cpp_vendor"
    cat > "$_zcv/cactus-zenoh-build-fixes.patch" <<'CACTUSPATCH'
diff --git a/build-resources/opaque-types/Cargo.toml b/build-resources/opaque-types/Cargo.toml
index 9a1453c..e6b6aad 100644
