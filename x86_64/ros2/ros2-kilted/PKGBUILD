+
+# static_init 1.0.3 (pinned via the copied Cargo.lock) fails to compile in the dev
+# profile unless "debug_order" is enabled; dependency features are not recorded in
+# Cargo.lock, so enable it here (mirrors upstream zenoh-c fix #1333).
+static_init = { version = "1", features = ["debug_order"] }
 const_format = "0.2.32"
 flume = "*"
 tokio = "*"
diff --git a/buildrs/cbindgen_generator.rs b/buildrs/cbindgen_generator.rs
