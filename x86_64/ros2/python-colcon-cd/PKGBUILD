# Maintainer: Achmad Fathoni<fathoni.id(at)gmail.com>
pkgname=python-colcon-cd
_name=${pkgname:7}
pkgver=0.2.1
pkgrel=4
pkgdesc="A shell function for colcon-core to change the current working directory."
arch=(any)
url="https://pypi.org/project/$_name"
license=('Apache')
depends=('python-colcon-core')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
source=(https://github.com/colcon/colcon-cd/archive/refs/tags/${pkgver}.tar.gz)
sha256sums=('91f14108b6f9db780fc5a579b9c809e9a8c62b688e81f2267788fd0e12f178dc')

build() {
    cd ${srcdir}/${_name}-${pkgver}
    python -m build --wheel --no-isolation
}

check() {
    cd ${srcdir}/${_name}-${pkgver}
    # spell check needs scspell (lib2to3, removed in Python 3.13); flake8 lint fails on newer flake8
    pytest test --ignore=test/test_spell_check.py --ignore=test/test_flake8.py
}

package() {
    cd ${srcdir}/${_name}-${pkgver}
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -D -m644 README.rst -t "${pkgdir}/usr/share/doc/${pkgname}"
}
makedepends+=("python-build" "python-installer" "python-wheel")
