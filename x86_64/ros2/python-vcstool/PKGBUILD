# Maintainer: Kartik Mohta <kartikmohta@gmail.com>

pkgname=('python-vcstool')
pkgver='0.3.0'
pkgrel=6
pkgdesc='A version control system tool designed to make working with multiple repositories easier'
arch=('any')
url='https://github.com/dirk-thomas/vcstool'
license=('Apache')
depends=('python' 'python-setuptools' 'python-yaml')
makedepends=('python-setuptools')

conflicts=('python2-vcstool')
source=("https://github.com/dirk-thomas/vcstool/archive/${pkgver}.tar.gz")
sha256sums=('2b6e4a97454983166e9a5fe08aca41cd8b28288ef693b954bc0e8b8518eafd3b')

_module='vcstool'

build() {
    cd "${srcdir}/${_module}-${pkgver}"
    python setup.py build
}

package() {
    cd "${srcdir}/${_module}-${pkgver}"
    python setup.py install --root="${pkgdir}" --optimize=1 --skip-build
}

prepare() {
    sed -i 's/^from pkg_resources import load_entry_point$/from importlib.metadata import entry_points\n\n\ndef load_entry_point(dist, group, name):\n    for ep in entry_points(group=group):\n        if ep.name == name:\n            return ep.load()\n    raise ImportError(name)/' "$srcdir/$_module-$pkgver/vcstool/commands/help.py"
}
