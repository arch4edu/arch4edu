pkgname=ros2-humble
pkgver=2026.02.20
pkgrel=3
pkgdesc="A set of software libraries and tools for building robot applications"
url="https://docs.ros.org/en/humble/"
arch=('x86_64')
license=('Apache')
depends=(
    'ros2-arch-deps'
    'qt6-base'
    'nvidia-cg-toolkit'
    'assimp'
    'gmock'
)
makedepends=('cmake' 'git')
provides=('ros2-humble-base')
conflicts=('ros2-humble-base')
source=(
    "ros2::git+https://github.com/ros2/ros2#tag=release-humble-${pkgver//.}"
)
sha256sums=('SKIP')
install=ros2-humble.install

prepare() {
    # Check locale according to
    # https://docs.ros.org/en/rolling/Installation/Ubuntu-Development-Setup.html#set-locale
    if ! locale | grep LANG | grep 'UTF-8\|utf8' > /dev/null; then
        echo 'Your locale must support UTF-8. See ' \
             'https://wiki.archlinux.org/index.php/locale and ' \
             'https://docs.ros.org/en/rolling/Installation/Ubuntu-Development-Setup.html#set-locale'
        exit 1
    fi

    # Clone the repos
    mkdir -p $srcdir/ros2/src
    vcs import $srcdir/ros2/src < $srcdir/ros2/ros2.repos

    cd $srcdir/ros2/src/eProsima/Fast-DDS
    git submodule update --init thirdparty/asio

    # pybind11_vendor: Use jazzy branch to make compatible with Python 3.11 and later.
    git -C $srcdir/ros2/src/ros2/pybind11_vendor checkout 3.1.3
}

_build() {
    # Disable parallel build if RAM is low
    MIN_PARALLEL_BUILD_RAM_KB=16000000
    if [[ $(free | grep -Po "Mem:\s+\K\d+") -lt $MIN_PARALLEL_BUILD_RAM_KB && $(grep MemTotal /proc/meminfo | grep -Po "MemTotal:\s+\K\d+") -lt $MIN_PARALLEL_BUILD_RAM_KB ]]; then
        printf "\nRAM is smaller than 16 GB. Parallel build will be disabled for stability.\n\n"
        export COLCON_EXTRA_ARGS="${COLCON_EXTRA_ARGS} --executor sequential"
    fi

    ## For people with the old version of makepkg.conf
    unset CPPFLAGS
    ## For people with the new version of makepkg.conf
    CFLAGS=$(sed "s/-Wp,-D_FORTIFY_SOURCE=[23]\s//g" <(echo $CFLAGS))
    CXXFLAGS=$(sed "s/-Wp,-D_FORTIFY_SOURCE=[23]\s//g" <(echo $CXXFLAGS))
    ## Fix missing cstdint headers in many packages
    CXXFLAGS+=" --include=cstdint"

    export CMAKE_POLICY_VERSION_MINIMUM=3.5

    # Build
    ## To resolve the io_service removal in Asio 1.33.0, build FastRTPS against third-party Asio.
    colcon build --merge-install --packages-up-to fastrtps --cmake-args " -DTHIRDPARTY_Asio=FORCE"
    ## Build all packages.
    colcon build --merge-install ${COLCON_EXTRA_ARGS} --cmake-args " -DBUILD_TESTING=OFF -Wno-dev" --packages-ignore qt_gui_cpp rqt_gui_cpp rosidl_typesupport_introspection_tests
}

_package() {
    mkdir -p $pkgdir/opt/ros/humble
    cp -r $srcdir/install/* $pkgdir/opt/ros/humble/
}

build() {
    # Fast-DDS's pinned asio predates OpenSSL 4: use accessor APIs and const X509 types.
    asio_file="$srcdir/ros2/src/eProsima/Fast-DDS/thirdparty/asio/asio/include/asio/ssl/impl/rfc2818_verification.ipp"
    sed -i \
      -e 's/if (domain->type == V_ASN1_IA5STRING && domain->data && domain->length)/if (ASN1_STRING_type(domain) == V_ASN1_IA5STRING \&\& ASN1_STRING_get0_data(domain) \&\& ASN1_STRING_length(domain))/' \
      -e 's/reinterpret_cast<const char\*>(domain->data)/reinterpret_cast<const char*>(ASN1_STRING_get0_data(domain))/' \
      -e 's/std::size_t pattern_length = domain->length;/std::size_t pattern_length = ASN1_STRING_length(domain);/' \
      -e 's/if (ip_address->type == V_ASN1_OCTET_STRING && ip_address->data)/if (ASN1_STRING_type(ip_address) == V_ASN1_OCTET_STRING \&\& ASN1_STRING_get0_data(ip_address))/' \
      -e 's/if (address.is_v4() && ip_address->length == 4)/if (address.is_v4() \&\& ASN1_STRING_length(ip_address) == 4)/' \
      -e 's/if (memcmp(bytes.data(), ip_address->data, 4) == 0)/if (memcmp(bytes.data(), ASN1_STRING_get0_data(ip_address), 4) == 0)/' \
      -e 's/else if (address.is_v6() && ip_address->length == 16)/else if (address.is_v6() \&\& ASN1_STRING_length(ip_address) == 16)/' \
      -e 's/if (memcmp(bytes.data(), ip_address->data, 16) == 0)/if (memcmp(bytes.data(), ASN1_STRING_get0_data(ip_address), 16) == 0)/' \
      -e 's/^  X509_NAME\* name = X509_get_subject_name(cert);$/  const X509_NAME* name = X509_get_subject_name(cert);/' \
      -e 's/^  ASN1_STRING\* common_name = 0;$/  const ASN1_STRING* common_name = 0;/' \
      -e 's/^    X509_NAME_ENTRY\* name_entry = X509_NAME_get_entry(name, i);$/    const X509_NAME_ENTRY* name_entry = X509_NAME_get_entry(name, i);/' \
      -e 's/if (common_name && common_name->data && common_name->length)/if (common_name \&\& ASN1_STRING_get0_data(common_name) \&\& ASN1_STRING_length(common_name))/' \
      -e 's/reinterpret_cast<const char\*>(common_name->data)/reinterpret_cast<const char*>(ASN1_STRING_get0_data(common_name))/' \
      -e 's/std::size_t pattern_length = common_name->length;/std::size_t pattern_length = ASN1_STRING_length(common_name);/' \
      "$asio_file"
    printf '\nif(NOT DEFINED Eigen3_INCLUDE_DIRS AND TARGET Eigen3::Eigen)\n  get_target_property(Eigen3_INCLUDE_DIRS Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)\nendif()\n' >> "$srcdir/ros2/src/ros2/eigen3_cmake_module/cmake/Modules/FindEigen3.cmake"
    sed -i '/^[[:space:]]*-Wall$/d;/^[[:space:]]*-Wextra$/d;/^[[:space:]]*-Wpedantic$/d' "$srcdir/ros2/src/ros2/console_bridge_vendor/CMakeLists.txt"
    _build
}

package() {
    _package
    grep -rIl "/build/ros2-humble" "$pkgdir/opt/ros/humble" | xargs -n 10 -- sed -i "s|/build/ros2-humble/src/install|/opt/ros/humble|g; s|/build/ros2-humble/src/build|/opt/ros/humble/opt|g"
}
