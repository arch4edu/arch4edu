post_install() {
  echo -e "\e[1;33m==>\e[0m Possible configurations in \e[1;31m/etc/pihole/pihole.toml\e[0m file"
  echo -e "\e[1;33m==>\e[0m Please read the instructions on the project page: \e[1;36mhttps://docs.pi-hole.net/ftldns/configfile/\e[0m"
}

post_upgrade() {
  # NOTE: /opt/pihole/updatecheck.sh is deliberately not run here. It queries
  # GitHub for Core/Web/FTL versions, which stalls or errors during the pacman
  # transaction when DNS is unavailable - likely, since Pi-hole serves it.
  # /etc/pihole/versions is refreshed by the periodic update check instead.
  post_install $1
}

post_remove() {
  /bin/true
}
