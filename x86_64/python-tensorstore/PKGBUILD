# Maintainer: Daniel Bershatsky <bepshatsky@yandex.ru>
pkgname=python-tensorstore
_pkgname=${pkgname#python-}
pkgver=0.1.86
pkgrel=1
pkgdesc='Library for reading and writing large multi-dimensional arrays.'
arch=('x86_64')
url='https://github.com/google/tensorstore'
license=('Apache-2.0')
depends=(
    'abseil-cpp'
    'aws-c-auth'
    'aws-c-cal'
    'aws-c-common'
    'aws-c-compression'
    'aws-c-http'
    'aws-c-io'
    'aws-c-sdkutils'
    'aws-checksums'
    'blosc'
    'brotli'
    'bzip2'
    'c-ares'
    'curl'
    'glibc'
    'libavif'
    'libblake3'
    'libgcc'
    'libjpeg-turbo'
    'libnghttp2'
    'libpng'
    'libstdc++'
    'libtiff'
    'libwebp'
    'lz4'
    'openssl'
    'python'
    'python-ml-dtypes'
    'python-numpy'
    're2'
    's2n-tls'
    'snappy'
    'tinyxml2'
    'xz'
    'zlib'
    'zstd'
)
makedepends=(
    'nlohmann-json'
    'pkgconf'
    'pybind11'
    'python-build'
    'python-installer'
    'python-pip'
    'python-setuptools'
    'python-setuptools-scm'
    'python-wheel'
)
source=("$_pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'system-libs.patch'
        'system-abseil.patch'
        'system-python-libs.patch'
        'grpc-openssl4.patch')
sha256sums=('fbc535275a766a17f636952cb10a766ed125f21282d4fd2bfdf95923c1c2cbe9'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
    cd "$_pkgname-$pkgver"

    # Upstrem gRPC already has the patch.
    install -m644 "$srcdir/grpc-openssl4.patch" third_party/grpc/patches/openssl4.diff

    declare -a _patches=(
        'system-libs.patch'
        'system-abseil.patch'
        'system-python-libs.patch'
    )
    local _patch
    for _patch in "${_patches[@]}"; do
        patch --fuzz=0 -Np1 -i "$srcdir/$_patch"
    done
}

build() {
    cd "$_pkgname-$pkgver"

    local _system_libs=(
        abseil-cpp
        aws_c_auth
        aws_c_cal
        aws_c_common
        aws_c_compression
        aws_c_http
        aws_c_io
        aws_c_sdkutils
        aws_checksums
        aws_s2n_tls
        blake3
        boringssl
        brotli
        bzip2
        c-ares
        com_github_pybind_pybind11
        curl
        libjpeg_turbo
        libpng
        libtiff
        libwebp
        lz4
        nlohmann_json
        org_aomedia_avif
        org_blosc_cblosc
        org_nghttp2
        re2
        snappy
        tinyxml2
        xz
        zlib
        zstd
    )
    export TENSORSTORE_SYSTEM_LIBS="${_system_libs[*]}"
    export TENSORSTORE_SYSTEM_LIBS="${TENSORSTORE_SYSTEM_LIBS// /,}"
    # Patch system-python-libs.patch restores this option for the Python repo
    # rules in v0.1.86 .
    export TENSORSTORE_SYSTEM_PYTHON_LIBS=numpy,ml_dtypes
    export TENSORSTORE_BAZEL_BUILD_OPTIONS='--repo_env=BAZEL_LINKOPTS=-Wl,--as-needed'
    export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
    python -m build -n -w
}

package() {
    cd $_pkgname-$pkgver
    install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    python -m installer --compile-bytecode=1 --destdir=$pkgdir \
        dist/$_pkgname-$pkgver-*.whl
}
makedepends+=("python-pip")
